{
  "manifest_version": 3,
  "name": "Daily Limits",
  "version": "1.0.0",
  "description": "Daily time limits for distracting sites, special rules for YouTube, and deliberate friction against loosening them.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "alarms", "idle", "tabs", "webNavigation", "notifications"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Daily Limits",
    "default_popup": "src/pages/popup.html"
  },
  "options_page": "src/pages/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/yt-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/yt-content.js"],
      "css": ["src/content/yt.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/embed/*", "*://*.youtube-nocookie.com/embed/*"],
      "js": ["src/content/yt-embed.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
